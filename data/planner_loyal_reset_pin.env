# Planner-loyal reset pin. Hot-reload (no worker restart after this code is loaded).
# Precedence: INDEX > RANGE > WEIGHTS > SET. Blank knobs = uniform over every loadable start.
# Exclusive pins that match no minted start fall back to the full pool.

# March mode (auto): 100% starts on pl03 (tape capture). pl03 crystalized 2026-09-12
# (fat remint -36 frames, beats thin -49); hunting pl04.
# RE1_PLANNER_MARCH=1 auto-rolls the INDEX forward once live pl{N+1} beats the
# pre-march champion row (data/planner_march_champions.json) on HP, kills,
# damage-weighted ammo, and frames — after a minimum RE1_PLANNER_MARCH_MIN_S
# grind (default 600s) — then crystalizes it and resets the NN to base weights.
# Blank/disabled = human-operated pin (previous behavior).
RE1_PLANNER_RESET_PIN_INDEX=3

RE1_PLANNER_MARCH=1

RE1_PLANNER_RESET_PIN_RANGE=

RE1_PLANNER_RESET_PIN_WEIGHTS=

RE1_PLANNER_RESET_PIN_SET=

RE1_PLANNER_RESET_PIN_SET_WEIGHT=
