# Planner-loyal reset pin. Hot-reload (no worker restart after this code is loaded).
# Precedence: INDEX > RANGE > WEIGHTS > SET. Blank knobs = uniform over every loadable start.
# Exclusive pins that match no minted start fall back to the full pool.

# March mode (auto): 100% starts on pl14 (tape capture). Hunting pl15.
# RE1_PLANNER_MARCH=1 auto-rolls the INDEX forward once live pl{N+1} meets
# champion HP/kills/ammo and hop frames <= 1.1x docs/planner_loyal_resources.md
# Frames — after a minimum RE1_PLANNER_MARCH_MIN_S grind (default 600s) — then
# crystalizes it and resets the NN to base weights. Any INDEX pin move (manual
# or auto) also requests that weight reset.
# Blank/disabled = human-operated pin (previous behavior).
RE1_PLANNER_RESET_PIN_INDEX=14

RE1_PLANNER_MARCH=1

# Grind trial: 60s min-dwell per PL (default 600s). Hot-reloaded every reset,
# no restart needed; preserved across march INDEX rewrites.
RE1_PLANNER_MARCH_MIN_S=60

# Per-hop dwell (needs worker restart to activate): min grind = 1.2s per
# recorded target frame, e.g. 23f -> ~28s, 449f -> ~9min. Unknown target
# falls back to MIN_S above. Hot-reloaded value, code-gated rollout.
RE1_PLANNER_MARCH_MIN_S_PER_FRAME=1.2

# Frames budget for march advance vs resources.md Frames column (default 1.1).
RE1_PLANNER_MARCH_FRAMES_FACTOR=1.1

RE1_PLANNER_RESET_PIN_RANGE=

RE1_PLANNER_RESET_PIN_WEIGHTS=

RE1_PLANNER_RESET_PIN_SET=

RE1_PLANNER_RESET_PIN_SET_WEIGHT=
