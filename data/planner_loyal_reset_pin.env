# Planner-loyal reset pin. Hot-reload (no worker restart after this code is loaded).
# Precedence: INDEX > RANGE > WEIGHTS > SET. Blank knobs = uniform over every loadable start.
# Exclusive pins that match no minted start fall back to the full pool.

# 100% on one cell. Example: 12
RE1_PLANNER_RESET_PIN_INDEX=

# Uniform over inclusive span. Examples: 6-12   10:13   8,12
RE1_PLANNER_RESET_PIN_RANGE=

# Weighted mix. Examples:
#   18                  → 100% pl18 (bare index; used to be ignored)
#   latest              → 100% newest loadable PL (tracks mints)
#   latest:40,rest:60   → 40% newest, 60% uniform over the other starts
#   11:50,rest:50       → 50% pl11, 50% rest
#   6:25,11:25,12:50
# Aliases: latest|newest|front|frontier and rest|uniform|pool. Percents or fractions.
RE1_PLANNER_RESET_PIN_WEIGHTS=latest:20,rest:80

# Named cells, exclusive if SET_WEIGHT blank. Example: 6,11,12
RE1_PLANNER_RESET_PIN_SET=

# Share for SET; remainder is the other starts. Examples: 0.4   40   40%
RE1_PLANNER_RESET_PIN_SET_WEIGHT=
