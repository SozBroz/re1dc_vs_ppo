# Hot-reload Yawn reset pin (no worker restart). Copy to data/yawn_reset_pin.env
# and edit while the worker runs — read on every episode reset.
#
# Single cell (hunt cp{N+1} after loading cpN):
# RE1_YAWN_RESET_PIN_INDEX=36
#
# Uniform span (inclusive):
# RE1_YAWN_RESET_PIN_RANGE=33-36
#
# Same span plus a dining-room fresh start (equal weight; 100% fresh if empty):
# RE1_YAWN_RESET_PIN_RANGE=0-8
# RE1_YAWN_RESET_PIN_INCLUDE_FRESH=1
#
# Explicit per-cell distribution (percentages or fractions; auto-normalized):
# RE1_YAWN_RESET_PIN_WEIGHTS=33:20,36:30,40:50
# RE1_YAWN_RESET_PIN_WEIGHTS=33=0.2,36=0.3,40=0.5
#
# Mix fixed cells with the dynamic frontier (updates as new cpNN land):
# RE1_YAWN_RESET_PIN_WEIGHTS=latest:60,33:20,36:20
#
# Weighted set blend with default mix (legacy):
# RE1_YAWN_RESET_PIN_SET=36,40,44
# RE1_YAWN_RESET_PIN_SET_WEIGHT=1.0
#
# Payforward fight grind (WH1/WH2; use data/workhorse_reset_pin.env on workhorses):
# RE1_YAWN_FIGHT_BIAS_INDEX=44
# RE1_YAWN_FIGHT_BIAS_WEIGHT=0.41
#
# Clear a key (empty value) to fall back to launcher env for that knob.
