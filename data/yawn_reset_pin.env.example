# Hot-reload Yawn reset pin (no worker restart). Copy to data/yawn_reset_pin.env
# and edit while the worker runs — read on every episode reset.
#
# Single cell (hunt cp{N+1} after loading cpN):
# RE1_YAWN_RESET_PIN_INDEX=36
#
# Uniform span (inclusive):
# RE1_YAWN_RESET_PIN_RANGE=33-36
#
# Weighted set blend (50% default):
# RE1_YAWN_RESET_PIN_SET=36,40,44
# RE1_YAWN_RESET_PIN_SET_WEIGHT=1.0
#
# Clear a key (empty value) to fall back to launcher env for that knob.
